{
	"name": "@jlizancandela/chatbox",
	"version": "0.1.0",
	"description": "Widget de chat con respuestas fundamentadas sobre un corpus documental (RAG).",
	"license": "MIT",
	"keywords": [
		"chat",
		"chatbox",
		"rag",
		"preact",
		"widget",
		"astro"
	],
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jlizancandela/chatbox.git"
	},
	"publishConfig": {
		"registry": "https://npm.pkg.github.com"
	},
	"exports": {
		".": "./src/index.ts",
		"./element": "./src/element.ts"
	},
	"files": [
		"src/components",
		"src/chat",
		"src/strings.es.ts",
		"src/css.d.ts",
		"src/index.ts",
		"src/element.ts",
		"README.md"
	],
	"sideEffects": [
		"**/*.css"
	],
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"lint": "biome check ./src ./test",
		"lint:fix": "biome check --write ./src ./test",
		"format": "biome format --write ./src ./test",
		"test": "vitest",
		"test:browser": "playwright test",
		"verify": "npm run lint && npm run typecheck && npm run build && npm run test -- --run",
		"test:watch": "vitest --watch",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"eventsource-parser": "^4.1.1",
		"react-markdown": "^10.1.0"
	},
	"peerDependencies": {
		"preact": "^10.6.5 || ^11.0.0"
	},
	"devDependencies": {
		"@babel/parser": "^7.29.9",
		"@biomejs/biome": "^2.5.15",
		"@playwright/test": "^1.64.1",
		"@preact/preset-vite": "^2.10.6",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/preact": "^3.2.4",
		"@testing-library/user-event": "^14.6.8",
		"@types/node": "^26.6.5",
		"axe-core": "^4.14.0",
		"jsdom": "^30.1.3",
		"postcss": "^8.5.29",
		"preact": "^11.0.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.1",
		"vitest": "^5.0.3"
	}
}
