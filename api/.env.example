# PostgreSQL used by the Docker Compose service and the API.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=chatbox
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/chatbox

# Required provider credentials. Replace placeholders locally; never commit real keys.
GEMINI_API_KEY=replace-with-gemini-api-key
GROQ_API_KEY=replace-with-groq-api-key

# Optional provider/model settings.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_VECTOR_DIMENSION=768
GROQ_MODEL_DEFAULT=openai/gpt-oss-20b
SIMILARITY_THRESHOLD=0.5

# Frontend origin allowed by CORS.
CORS_ORIGIN=http://localhost:3000

# Temporary conversation history limits used by `POST /api/chat`.
HISTORY_MAX_MESSAGES=20
HISTORY_MAX_MESSAGE_CHARS=2000
HISTORY_MAX_TOTAL_CHARS=8000
HISTORY_SESSION_TTL_MINUTES=15

# Schedule (5-field cron) to delete expired conversation sessions. Defaults to
# 03:00 every day in the server's local time.
HISTORY_CLEANUP_SCHEDULE=0 3 * * *

# Server secret used to derive the session key (HMAC-SHA256) from the client IP.
# The raw IP is never stored. Generate locally with: openssl rand -hex 32
HISTORY_HMAC_SECRET=replac…-with-openssl-rand-hex-32
