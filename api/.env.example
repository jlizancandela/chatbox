# PostgreSQL used by the Docker Compose service and the API.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=chatbox
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/chatbox

# Required provider credentials. Replace placeholders locally; never commit real keys.
# Embeddings run in-process: this is the only external provider.
GROQ_API_KEY=replace-with-groq-api-key

# Optional provider/model settings.
GROQ_MODEL_DEFAULT=openai/gpt-oss-20b
# Calibrated against EmbeddingGemma: the four widget questions land below 0.78 and
# off-topic questions mostly above 0.86. Recalibrate after changing the model.
SIMILARITY_THRESHOLD=0.8

# Self-hosted embeddings: where the model files live. The image bakes them into
# /app/model. Run `pnpm embeddings:fetch` once before starting the API locally.
EMBEDDING_CACHE_DIR=.cache/embeddings

# Retrieval: how many chunks are retrieved for a question.
RETRIEVAL_TOP_K=5

# Generation: temperature (0-2), token budget (reasoning included) and how hard
# the model reasons. "low" keeps a factual widget fast without giving up quality.
GENERATION_TEMPERATURE=0.6
GENERATION_MAX_COMPLETION_TOKENS=2048
GENERATION_REASONING_EFFORT=low

# Frontend origin allowed by CORS.
CORS_ORIGIN=http://localhost:3000

# Log level: fatal, error, warn, info, debug, trace or silent.
# "info" is the default and the right one for a server: it shows every request
# without filling the disk. An unknown level falls back to "info" instead of
# stopping the server from starting.
LOG_LEVEL=info

# Conversation history limits sent by the client in `POST /api/chat`.
# These are server-side safety caps: the client should also limit its own history.
HISTORY_MAX_MESSAGES=12
HISTORY_MAX_MESSAGE_CHARS=1000
HISTORY_MAX_TOTAL_CHARS=4000

# Budget per conversation (#148). The session id travels in `x-session-id` and is
# generated by the client. The budget is equity between visitors, not security:
# rotating the session id resets it. The real backstop is the global daily cap.
SESSION_BUDGET_MAX_TOKENS=20000
SESSION_BUDGET_MAX_TURNS=12
