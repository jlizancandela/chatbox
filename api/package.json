{
  "name": "api",
  "version": "1.0.0",
  "description": "This project was bootstrapped with Fastify-CLI.",
  "main": "app.ts",
  "packageManager": "pnpm@11.9.0",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test:run": "node --test --env-file-if-exists=.env -r ts-node/register -r ./test/setup.ts \"test/**/*.test.ts\"",
    "test": "npm run build:ts && tsc -p test/tsconfig.json && c8 npm run test:run",
    "verify": "npm run build:ts && tsc -p test/tsconfig.json && npm run test:run",
    "start": "npm run build:ts && fastify start -l warn dist/app.js",
    "build:ts": "tsc",
    "db:migrate": "node-pg-migrate up --migrations-dir database/migrations --migrations-table pgmigrations",
    "ingest": "npm run build:ts && node --env-file=.env dist/cli/ingest.js",
    "embeddings:fetch": "npm run build:ts && node --env-file-if-exists=.env dist/cli/fetchEmbeddingModel.js",
    "watch:ts": "tsc -w",
    "dev": "npm run build:ts && concurrently -k -p \"[{name}]\" -n \"TypeScript,App\" -c \"yellow.bold,cyan.bold\" \"npm:watch:ts\" \"npm:dev:start\"",
    "dev:start": "fastify start -a 0.0.0.0 -p 7000 --ignore-watch=.ts$ -w -l warn -P dist/app.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/autoload": "^6.0.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/postgres": "^6.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/sensible": "^6.0.0",
    "@huggingface/transformers": "^4.3.2",
    "@langchain/textsplitters": "^1.0.1",
    "fastify": "^5.0.0",
    "fastify-cli": "^8.0.0",
    "fastify-plugin": "^5.0.0",
    "groq-sdk": "^1.5.0",
    "node-cron": "^3.0.3",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.22.0",
    "pgvector": "^0.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/node": "^25.9.5",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.23.1",
    "c8": "^11.0.0",
    "concurrently": "^9.0.0",
    "fastify-tsconfig": "^3.0.0",
    "ts-node": "^10.4.0",
    "typescript": "~5.9.2"
  }
}
