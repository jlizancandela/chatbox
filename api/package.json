{
  "name": "api",
  "version": "1.0.0",
  "description": "This project was bootstrapped with Fastify-CLI.",
  "main": "app.ts",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "npm run build:ts && tsc -p test/tsconfig.json && c8 node --test -r ts-node/register \"test/**/*.ts\"",
    "start": "npm run build:ts && fastify start -l info dist/app.js",
    "build:ts": "tsc",
    "db:migrate": "node-pg-migrate up --migrations-dir database/migrations --migrations-table pgmigrations",
    "watch:ts": "tsc -w",
    "dev": "npm run build:ts && concurrently -k -p \"[{name}]\" -n \"TypeScript,App\" -c \"yellow.bold,cyan.bold\" \"npm:watch:ts\" \"npm:dev:start\"",
    "dev:start": "fastify start -a 0.0.0.0 -p 7000 --ignore-watch=.ts$ -w -l info -P dist/app.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@chonkiejs/core": "^0.0.11",
    "@fastify/autoload": "^6.0.0",
    "@fastify/postgres": "^6.1.0",
    "@fastify/sensible": "^6.0.0",
    "@google/genai": "^2.17.0",
    "fastify": "^5.0.0",
    "fastify-cli": "^8.0.0",
    "fastify-plugin": "^5.0.0",
    "pg": "^8.22.0",
    "pgvector": "^0.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/node": "^25.9.5",
    "c8": "^11.0.0",
    "concurrently": "^9.0.0",
    "fastify-tsconfig": "^3.0.0",
    "node-pg-migrate": "^9.0.0",
    "ts-node": "^10.4.0",
    "typescript": "~5.9.2"
  }
}
